{
  "compilerOptions": {
    "module": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "rootDir": ".",
    "outDir": "./dist",
    "allowJs": true,
    "checkJs": true,
    "noEmit": false
  },
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  "exclude": ["eslint.config.js"]
}
